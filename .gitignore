node_modules/

# vendor/ IS committed. This project has no bundler, so the vendored three build is not a
# build artifact — it is what the site serves. GitHub Pages has no npm step, so a gitignored
# vendor/ means a deployed page that 404s its entire runtime.
# Refresh it with `npm run vendor` after bumping three in package.json.

.DS_Store
*.glb

# Deban decision log — private working memory, not a published artifact.
.deban/

# Design-canvas build output. `design/*.dc.html` + canvas.json + the image ARE committed —
# they are the source, and every later edit re-seeds from them. The seeded page beside them is
# 2.4 MB of embedded editor with the artboards inlined into it, regenerated on demand, and the
# published Artifact is where anyone actually looks at it.
design/controls-panel-overflow.html
